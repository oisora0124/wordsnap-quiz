{
  // WordBank / Cloudflare Pages + D1 の再現可能な設定（仕様書 §8）。
  // database_id はリソース識別子であり秘密情報ではない（APIトークンが無ければ何もできない）。コミットしてよい。
  "name": "wordbank",
  "compatibility_date": "2026-07-01",
  "pages_build_output_dir": "publish",

  // D1バインディング名は 'DB'（functions/api/wordsnap-state.js が env.DB を参照）。
  // migrations_dir はこのリポジトリの migrations/。
  // 0001=states, 0002=state_revisions, 0003=feedback, 0004=rooms(同期V2),
  // 0005=rate_limits, 0006=telemetry, 0007=telemetry.created_at の索引。
  // 一覧と「無いとどうなるか」は migrations/README.md にある。
  // database_name は未確認のため、authoritative な database_id で固定する。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordbank",
      "database_id": "ea941fb4-1b51-49e6-acd9-12501a4fa653",
      "migrations_dir": "migrations"
    }
  ]

  // ステージングと本番でDBを分けるときは env.staging / env.production を足し、
  // それぞれ別の database_id を指す（DEPLOY-005）。
}
