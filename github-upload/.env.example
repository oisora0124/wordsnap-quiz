# WordBank デプロイ用の環境変数の例。実際の値はコミットしない。
# Cloudflare ダッシュボードまたは `wrangler d1 create wordbank` で取得する。

# 本番D1のデータベースID（wrangler.jsonc の REPLACE_WITH_YOUR_D1_DATABASE_ID に入れる）
CLOUDFLARE_D1_DATABASE_ID=

# ステージング用D1（本番と別DB。DEPLOY-005）
CLOUDFLARE_D1_DATABASE_ID_STAGING=

# Pages デプロイに使うアカウント/トークン（CIから注入）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- フィードバックのメール通知（任意） ---
# すべて Pages のシークレット／環境変数として設定する。値はコミットしない。
#   wrangler pages secret put FEEDBACK_MAIL_TO --project-name wordbank
# 未設定なら通知しない（投稿は D1 の feedback テーブルに残る）。
FEEDBACK_MAIL_TO=
FEEDBACK_MAIL_FROM=
# 送信プロバイダのAPIキー。RESEND_API_KEY があればそちらを優先する。
RESEND_API_KEY=
BREVO_API_KEY=
